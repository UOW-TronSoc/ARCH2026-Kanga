<?xml version="1.0"?>
<package format="3">
  <name>kanga_microcontroller</name>
  <version>0.0.1</version>
  <description>Generic CAN bridge node for ESP32-based microcontrollers using the shared kanga_canbus stack.</description>
  <maintainer email="hunter.dejong03@gmail.com">Hunter</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>ament_cmake</build_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>kanga_canbus</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
