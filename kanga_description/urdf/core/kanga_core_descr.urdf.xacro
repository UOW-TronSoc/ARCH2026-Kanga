<?xml version="1.0" ?>
<robot name="kanga_core" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Wrapper file:
       include the reusable core macro and instantiate it as a standalone model. -->
  <xacro:include filename="$(find kanga_description)/urdf/core/kanga_core_macro.urdf.xacro"/>

  <xacro:kanga_core/>
</robot>
