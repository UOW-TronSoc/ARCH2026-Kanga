<?xml version="1.0" ?>
<!-- UniLidarL2 sensor model exported from Onshape and adapted for kanga_description meshes -->
<robot name="UniLidarL2">
  <!-- Link unilidarl2base -->
  <link name="unilidarl2base">
    <inertial>
      <origin xyz="-4.86924e-06 6.88756e-05 0.00436145" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="4.60192e-05" ixy="-1.473e-09" ixz="-3.537e-09" iyy="4.63963e-05" iyz="9.141e-08" izz="8.42575e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.53025 -1.94934e-06 0.313234" rpy="3.14159 -0.349066 -3.14159"/>
      <geometry>
        <mesh filename="package://kanga_description/meshes/sensors/unilidar_l2/unilidarl2base.stl"/>
      </geometry>
      <material name="unilidarl2base_material">
        <color rgba="0.301961 0.301961 0.301961 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.53025 -1.94934e-06 0.313234" rpy="3.14159 -0.349066 -3.14159"/>
      <geometry>
        <mesh filename="package://kanga_description/meshes/sensors/unilidar_l2/unilidarl2base.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Frame LidarBase (dummy link + fixed joint) -->
  <link name="LidarBase">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="LidarBase_frame" type="fixed">
    <origin xyz="0 0 -0" rpy="0 0 1.5708"/>
    <parent link="unilidarl2base"/>
    <child link="LidarBase"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- Link unilidarl2top -->
  <link name="unilidarl2top">
    <inertial>
      <origin xyz="-2.7414e-06 6.66489e-05 -0.0157604" rpy="0 0 0"/>
      <mass value="0.13"/>
      <inertia ixx="5.78833e-05" ixy="-1.075e-09" ixz="2.975e-09" iyy="3.66094e-05" iyz="9.3857e-08" izz="7.00661e-05"/>
    </inertial>
    <visual>
      <origin xyz="-0.53025 -1.94934e-06 -0.290634" rpy="-0 0.349066 -0"/>
      <geometry>
        <mesh filename="package://kanga_description/meshes/sensors/unilidar_l2/unilidarl2top.stl"/>
      </geometry>
      <material name="unilidarl2top_material">
        <color rgba="0.215686 0.215686 0.215686 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.53025 -1.94934e-06 -0.290634" rpy="-0 0.349066 -0"/>
      <geometry>
        <mesh filename="package://kanga_description/meshes/sensors/unilidar_l2/unilidarl2top.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint from unilidarl2base to unilidarl2top -->
  <joint name="LidarTop" type="revolute">
    <origin xyz="0 0 0.0226" rpy="3.14159 -0 -3.14159"/>
    <parent link="unilidarl2base"/>
    <child link="unilidarl2top"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="0" upper="0"/>
  </joint>
</robot>
