<?xml version="1.0" ?>
<robot name="UniLidarL2_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reusable lidar component.
       Params:
       - parent: link this sensor mounts to
       - xyz/rpy: pose of the lidar relative to parent
       - prefix: optional name prefix to avoid link/joint collisions -->
  <xacro:macro name="unilidar_l2" params="parent xyz:='0 0 0' rpy:='0 0 0' prefix:=''">
    <!-- Mount joint from caller-provided parent to lidar base. -->
    <joint name="${prefix}UniLidarL2_mount_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${prefix}unilidarl2base"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- Main lidar body. -->
    <link name="${prefix}unilidarl2base">
      <inertial>
        <origin xyz="-4.86924e-06 6.88756e-05 0.00436145" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="4.60192e-05" ixy="-1.473e-09" ixz="-3.537e-09" iyy="4.63963e-05" iyz="9.141e-08" izz="8.42575e-05"/>
      </inertial>
      <visual>
        <origin xyz="0.53025 -1.94934e-06 0.313234" rpy="3.14159 -0.349066 -3.14159"/>
        <geometry>
          <mesh filename="package://kanga_description/meshes/sensors/unilidar_l2/unilidarl2base.stl"/>
        </geometry>
        <material name="unilidarl2base_material">
          <color rgba="0.301961 0.301961 0.301961 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.53025 -1.94934e-06 0.313234" rpy="3.14159 -0.349066 -3.14159"/>
        <geometry>
          <mesh filename="package://kanga_description/meshes/sensors/unilidar_l2/unilidarl2base.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- Reference frame exported by the CAD model for downstream attachments. -->
    <link name="${prefix}LidarBase">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}LidarBase_frame" type="fixed">
      <origin xyz="0 0 -0" rpy="0 0 1.5708"/>
      <parent link="${prefix}unilidarl2base"/>
      <child link="${prefix}LidarBase"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- Rotating top cap of the lidar. -->
    <link name="${prefix}unilidarl2top">
      <inertial>
        <origin xyz="-2.7414e-06 6.66489e-05 -0.0157604" rpy="0 0 0"/>
        <mass value="0.13"/>
        <inertia ixx="5.78833e-05" ixy="-1.075e-09" ixz="2.975e-09" iyy="3.66094e-05" iyz="9.3857e-08" izz="7.00661e-05"/>
      </inertial>
      <visual>
        <origin xyz="-0.53025 -1.94934e-06 -0.290634" rpy="-0 0.349066 -0"/>
        <geometry>
          <mesh filename="package://kanga_description/meshes/sensors/unilidar_l2/unilidarl2top.stl"/>
        </geometry>
        <material name="unilidarl2top_material">
          <color rgba="0.215686 0.215686 0.215686 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.53025 -1.94934e-06 -0.290634" rpy="-0 0.349066 -0"/>
        <geometry>
          <mesh filename="package://kanga_description/meshes/sensors/unilidar_l2/unilidarl2top.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- Spin joint from base to top cap (currently constrained by limits). -->
    <joint name="${prefix}LidarTop" type="revolute">
      <origin xyz="0 0 0.0226" rpy="3.14159 -0 -3.14159"/>
      <parent link="${prefix}unilidarl2base"/>
      <child link="${prefix}unilidarl2top"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="0" upper="0"/>
    </joint>
  </xacro:macro>
</robot>
