<?xml version="1.0" ?>
<robot name="kanga_arm_gripper_simple" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Top-level assembly:
       combine kanga core simple (no suspension) + arm payload + simple arm gripper payload (no D435i). -->
  <xacro:include filename="$(find kanga_description)/urdf/core/kanga_core_simple_macro.urdf.xacro"/>
  <xacro:include filename="$(find kanga_description)/urdf/payloads/arm/arm_payload_macro.urdf.xacro"/>
  <xacro:include filename="$(find kanga_description)/urdf/payloads/arm/arm_gripper_payload_simple_macro.urdf.xacro"/>

  <!-- Build simple rover core first. -->
  <xacro:kanga_core_simple/>
  <!-- Mount arm payload to the rover top payload mount. -->
  <xacro:arm_payload parent="top_payload_mount"/>
  <!-- Mount simple gripper payload to arm end-effector. -->
  <xacro:arm_gripper_payload_simple parent="end_effector_mount"/>
</robot>
