<?xml version="1.0" ?>
<robot name="autonomous_zed_payload_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reuse the ZED wrapper camera macro from stereolabs. -->
  <xacro:include filename="$(find zed_wrapper)/urdf/zed_macro.urdf.xacro"/>

  <!-- Reusable autonomous ZED payload.
       Params:
       - parent: link this payload mounts to
       - xyz/rpy: payload pose relative to parent
       - prefix: optional name prefix for multi-instance safety
       - camera_name: prefix used by zed_wrapper links/joints
       - camera_model: ZED model string (zed2i, zed2, zedx, ...) -->
  <xacro:macro name="autonomous_zed_payload" params="parent xyz:='0 0 0' rpy:='0 0 0' prefix:='' camera_name:='zed' camera_model:='zed2i'">
    <!-- Mount payload body to caller-provided parent link. -->
    <joint name="${prefix}autonomous_zed_payload_mount_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${prefix}autonomous_zed_mount"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- Payload bracket geometry that bolts to rover top mount. -->
    <link name="${prefix}autonomous_zed_mount">
      <inertial>
        <origin xyz="0.00610768 9.5471e-08 0.0173842" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.000182159" ixy="-7.8e-11" ixz="-3.26034e-06" iyy="1.74442e-05" iyz="-2.77e-10" izz="0.000166422"/>
      </inertial>
      <visual>
        <origin xyz="0.015 0.000556129 -0.156852" rpy="-1.5708 -0 1.5708"/>
        <geometry>
          <mesh filename="package://kanga_description/meshes/payloads/auto/autonomous_zed_mount.stl"/>
        </geometry>
        <material name="autonomous_zed_mount_material">
          <color rgba="0.262745 0.282353 0.301961 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.015 0.000556129 -0.156852" rpy="-1.5708 -0 1.5708"/>
        <geometry>
          <mesh filename="package://kanga_description/meshes/payloads/auto/autonomous_zed_mount.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- ZED mounting frame exported from CAD. -->
    <link name="${prefix}zed_camera_mount">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}zed_camera_mount_frame" type="fixed">
      <origin xyz="0.0320595 -0 0.0225717" rpy="0 0.261799 0"/>
      <parent link="${prefix}autonomous_zed_mount"/>
      <child link="${prefix}zed_camera_mount"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- Instantiate ZED camera description (creates <name>_camera_link and children). -->
    <xacro:zed_camera name="${prefix}${camera_name}" model="${camera_model}" enable_gnss="false">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:zed_camera>

    <!-- Attach camera root frame to the payload mount frame.
         Tutorial convention: connect <camera_name>_camera_link to robot mount link. -->
    <joint name="${prefix}${camera_name}_camera_mount_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}zed_camera_mount"/>
      <child link="${prefix}${camera_name}_camera_link"/>
      <axis xyz="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
