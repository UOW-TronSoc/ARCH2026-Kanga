<?xml version="1.0" ?>
<robot name="autonomous_lidar_payload_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reuse the lidar sensor macro so payload does not duplicate lidar URDF content. -->
  <xacro:include filename="$(find kanga_description)/urdf/sensors/UniLidarL2/UniLidarL2_macro.urdf.xacro"/>

  <!-- Reusable autonomous lidar payload.
       Params:
       - parent: link this payload mounts to
       - xyz/rpy: payload pose relative to parent
       - prefix: optional name prefix for multi-instance safety -->
  <xacro:macro name="autonomous_lidar_payload" params="parent xyz:='0 0 0' rpy:='0 0 0' prefix:=''">
    <!-- Mount payload body to caller-provided parent link. -->
    <joint name="${prefix}autonomous_payload_mount_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${prefix}autonomouslidarmount"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- Payload bracket geometry that bolts to rover top mount. -->
    <link name="${prefix}autonomouslidarmount">
      <inertial>
        <origin xyz="-0.0301856 0.1375 0.184178" rpy="0 0 0"/>
        <mass value="0.4"/>
        <inertia ixx="0.0134847" ixy="3.8e-11" ixz="4.99203e-06" iyy="0.0100213" iyz="-2.9141e-08" izz="0.00357387"/>
      </inertial>
      <visual>
        <origin xyz="-0.420514 0.1375 -0.1216" rpy="-0 -0 0"/>
        <geometry>
          <mesh filename="package://kanga_description/meshes/payloads/auto/autonomouslidarmount.stl"/>
        </geometry>
        <material name="autonomouslidarmount_material">
          <color rgba="0.231373 0.380392 0.705882 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.420514 0.1375 -0.1216" rpy="-0 -0 0"/>
        <geometry>
          <mesh filename="package://kanga_description/meshes/payloads/auto/autonomouslidarmount.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- Lidar mounting frame exported from CAD for sensor placement. -->
    <link name="${prefix}UniLidarL2Mount">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}UniLidarL2Mount_frame" type="fixed">
      <origin xyz="-0.0300581 0.1375 0.355979" rpy="2.79253 -0 1.5708"/>
      <parent link="${prefix}autonomouslidarmount"/>
      <child link="${prefix}UniLidarL2Mount"/>
      <axis xyz="0 0 0"/>
    </joint>

    <!-- Attach reusable UniLidarL2 model at the payload's lidar mount frame. -->
    <xacro:unilidar_l2 parent="${prefix}UniLidarL2Mount" prefix="${prefix}"/>
  </xacro:macro>
</robot>
