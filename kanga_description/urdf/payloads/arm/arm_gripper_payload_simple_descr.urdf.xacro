<?xml version="1.0" ?>
<robot name="arm_gripper_payload_simple" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Wrapper file:
       include the reusable simple arm gripper macro (no D435i) and instantiate it standalone. -->
  <xacro:include filename="$(find kanga_description)/urdf/payloads/arm/arm_gripper_payload_simple_macro.urdf.xacro"/>

  <link name="base_link"/>
  <xacro:arm_gripper_payload_simple parent="base_link"/>
</robot>
